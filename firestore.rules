rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function clientOwnedUserFields() {
      return [
        'email',
        'emailVerified',
        'displayName',
        'photoURL',
        'phoneNumber',
        'authProvider',
        'authProviderUid',
        'createdOnPlatform',
        'preferences',
        'createdAt',
        'lastSignInAt',
        'updatedAt'
      ];
    }

    function serverOwnedUserFields() {
      return [
        'membershipStatus',
        'isPremium',
        'hasUsedTrial',
        'trialStartedAt',
        'trialEndsAt',
        'trialStartDate',
        'trialEndDate',
        'subscriptionStartedAt',
        'subscriptionEndsAt',
        'subscriptionPlan',
        'subscriptionSource',
        'subscriptionId',
        'subscriptionExpiryDate',
        'freeDebatesRemaining',
        'freeComparesRemaining',
        'freeChatsRemaining',
        'usage',
        'trialHistory',
        'loginAttempts',
        'autoRenewing',
        'lastReceiptData',
        'paymentPlatform',
        'productId',
        'androidPurchaseToken',
        'appAccountToken',
        'isLifetime',
        'lastValidated'
      ];
    }

    function isClientOwnedUserCreate() {
      return request.resource.data.keys().hasOnly(clientOwnedUserFields())
        && !request.resource.data.keys().hasAny(serverOwnedUserFields());
    }

    function isClientOwnedUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientOwnedUserFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedUserFields());
    }

    function isClientWritableUserSubcollection(subcollection) {
      return !(subcollection in [
        'apiKeys',
        'usage',
        'billing',
        'subscription',
        'subscriptions',
        'receipts'
      ]);
    }

    // Users can read their own profile and only write client-owned profile fields.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isClientOwnedUserCreate();
      allow update: if isOwner(userId) && isClientOwnedUserUpdate();
      allow delete: if false;

      // API Keys - ONLY accessible via Cloud Functions (admin SDK)
      match /apiKeys/{providerId} {
        allow read, write: if false;
      }

      // Usage collection is function-owned. Clients may read their own counters.
      match /usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;

        // Daily usage: usage/daily/days/{date}
        match /days/{date} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      // Billing/subscription state is function-owned.
      match /billing/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /{nestedDoc=**} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      match /subscription/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /subscriptions/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /receipts/{docId} {
        allow read, write: if false;
      }

      // Allow other client-owned subcollections (sessions, preferences, etc.).
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId)
          && isClientWritableUserSubcollection(subcollection);

        // Nested subcollections (e.g., sessions/messages)
        match /{nestedDoc=**} {
          allow read, write: if isOwner(userId)
            && isClientWritableUserSubcollection(subcollection);
        }
      }
    }
    
    // Conversations belong to authenticated users
    match /conversations/{conversationId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read, update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Allow delete if: user owns it OR session has no userId (legacy cleanup)
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || resource.data.userId == null);

      match /messages/{messageId} {
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;

        allow read, update: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;

        // Allow delete if: user owns parent OR parent has no userId (legacy cleanup)
        allow delete: if request.auth != null
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid
              || get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == null);
      }
    }

    // Trial history - prevents trial abuse after account deletion
    // Users can read their own trial history, but only cloud functions can write
    match /trialHistory/{docId} {
      allow read: if request.auth != null && request.auth.uid == docId;
      allow write: if false; // Only cloud functions (admin SDK) can write
    }

    // Auth rate-limit state - only cloud functions (admin SDK) can access
    match /loginAttempts/{docId} {
      allow read, write: if false;
    }

    // Export Jobs - creator can read status, only cloud functions write
    match /exportJobs/{jobId} {
      allow read: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow write: if false;
    }

    // Purchase errors - for debugging Play Store review failures
    // Allow any authenticated user to write (create only), no reads from client
    match /purchase_errors/{docId} {
      allow create: if true; // Allow even unauthenticated to log errors
      allow read, update, delete: if false; // Only viewable in Firebase Console
    }
  }
}
