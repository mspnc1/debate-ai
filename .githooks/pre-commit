#!/bin/sh
echo "Running pre-commit checks..."

# TypeScript typecheck
npm run -s typecheck || {
  echo "Typecheck failed. Aborting commit." >&2
  exit 1
}

# ESLint
npm run -s lint || {
  echo "Lint failed. Aborting commit." >&2
  exit 1
}

npm run -s lint:any-budget || {
  echo "Lint warning budget failed. Aborting commit." >&2
  exit 1
}

echo "All pre-commit checks passed."
