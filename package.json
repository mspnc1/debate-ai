{
  "name": "symposium-ai",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:dev:reset": "bash scripts/dev/reset-android-dev-client.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "clean": "rm -rf ios android node_modules && npm install",
    "clean:ios": "cd ios && rm -rf Pods Podfile.lock && pod install && cd ..",
    "build:dev:ios": "eas build --platform ios --profile development --local",
    "build:dev:android": "eas build --platform android --profile development --local",
    "lint": "npm run lint:src && npm run lint:tests",
    "lint:src": "eslint src --ext .ts,.tsx",
    "lint:tests": "eslint __tests__ --ext .ts,.tsx",
    "lint:any-budget": "node scripts/quality/check-no-explicit-any-budget.mjs",
    "lint:fix": "eslint src __tests__ --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "check:app": "npm run typecheck && npm run lint && npm run lint:any-budget && npm run test",
    "check:functions": "npm --prefix functions run build && npm --prefix functions test",
    "audit:all": "npm audit --audit-level=moderate && npm --prefix functions audit --audit-level=moderate",
    "check:all": "npm run check:app && npm run check:functions && npm run audit:all",
    "check": "npm run check:app",
    "models:discover": "node scripts/discover-provider-models.mjs",
    "models:discover:check": "node scripts/discover-provider-models.mjs --check",
    "salesforce-docs:index": "npm --prefix functions run salesforce-docs:index --",
    "demo:build-recordings": "node scripts/demo/build-recordings-manifest.js",
    "demo:bridge": "node scripts/demo/dev-bridge.mjs",
    "purchase:test:inspect": "node scripts/purchase-testing/firestore-state.mjs inspect",
    "purchase:test:repair-trial": "node scripts/purchase-testing/firestore-state.mjs repair-trial-flag",
    "purchase:test:reset-entitlement": "node scripts/purchase-testing/firestore-state.mjs reset-entitlement",
    "purchase:test:reset-trial": "node scripts/purchase-testing/firestore-state.mjs reset-trial-eligibility",
    "purchase:test:capture-android": "bash scripts/purchase-testing/capture-android-purchase-evidence.sh",
    "test": "jest --watch=false --runInBand",
    "test:model-routing": "jest --runInBand __tests__/config/modelSelectionContract.test.ts __tests__/services/ai/ModelRoutingContract.test.ts __tests__/services/modelSelectionFlow.test.ts __tests__/hooks/home/useAISelection.test.ts __tests__/services/home/AIConfigurationService.test.ts",
    "test:model-routing:live": "LIVE_MODEL_TEST=1 jest --runInBand --runTestsByPath __tests__/integration/liveModelRouting.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --maxWorkers=50%",
    "eas-build-post-install": "bash scripts/eas-prebuild.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@expo/metro-runtime": "~55.0.6",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/auth": "^23.8.6",
    "@react-native-firebase/crashlytics": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "@react-native-firebase/functions": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.5",
    "@reduxjs/toolkit": "^2.9.0",
    "axios": "^1.13.6",
    "expo": "~55.0.5",
    "expo-apple-authentication": "~55.0.8",
    "expo-audio": "~55.0.14",
    "expo-auth-session": "~55.0.8",
    "expo-blur": "~55.0.9",
    "expo-build-properties": "~55.0.9",
    "expo-clipboard": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.9",
    "expo-device": "~55.0.9",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-haptics": "~55.0.8",
    "expo-image-manipulator": "~55.0.10",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.8",
    "expo-media-library": "~55.0.9",
    "expo-print": "~55.0.8",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.13",
    "expo-video": "~55.0.17",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-code-highlighter": "^1.3.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-iap": "^14.7.20",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "react-redux": "^9.2.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/js": "^9.33.0",
    "@testing-library/react-native": "^12.3.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "msw": "^2.4.10",
    "node-forge": "^1.3.3",
    "react-test-renderer": "^19.2.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.0",
    "whatwg-fetch": "^3.6.20"
  },
  "optionalDependencies": {
    "node-addon-api": "^8.6.0",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "markdown-it": "^14.3.0",
    "prismjs": "^1.30.0",
    "tar": "^7.5.7",
    "lodash": "^4.17.23",
    "fast-xml-parser": "^5.7.0",
    "http-proxy-agent": "^7.0.2",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "protobufjs": "^7.5.8",
    "@protobufjs/utf8": "^1.1.1",
    "websocket-driver": "^0.7.5"
  },
  "private": true
}
